# Backend
# Draft reset (commissioner) is only exposed when APP_ENV=development
APP_ENV=development
# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL (JSON format when APP_ENV=production)
LOG_LEVEL=INFO
# Local venv: use 127.0.0.1. Docker Compose API + host Supabase: use host.docker.internal
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Optional: direct/session URL for DDL if DATABASE_URL is a transaction pooler
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Docker examples:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres
# SUPABASE_URL=http://host.docker.internal:54321
# Auth JWTs verified via JWKS: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
FOOTBALL_DATA_API_TOKEN=your-football-data-org-token
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
CRON_SECRET=change-me-to-a-long-random-string
# Shared by API + Next.js BFF (server-only; never NEXT_PUBLIC_*). Required non-default in production.
INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Cloudflare Turnstile (siteverify on API). Local testing keys always pass:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Frontend hostnames allowed by siteverify (no scheme). Comma/space/semicolon separated.
# Production must not include localhost/127.0.0.1.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
# Dev only — skip JWT and authenticate as this invited email (forbidden when APP_ENV=production)
AUTH_BYPASS_EMAIL=
# Public frontend origin for invite accept + join links (required in production)
PUBLIC_APP_URL=http://localhost:3000
# Mailjet Send API v3.1 (required in production; optional in development)
# League invites send inline HTML from the backend (no Mailjet template ID).
MAILJET_API_KEY_PUBLIC=
MAILJET_API_KEY_PRIVATE=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Midtable

# Frontend (Next.js)
# Used as Docker Compose build-args for midtable-frontend (browser must use localhost, not service names).
# Also copy NEXT_PUBLIC_* + INTERNAL_API_SECRET into frontend/.env.local for `next dev` on the host.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Turnstile sitekey (public). Dummy always-pass key for local:
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
# Server-side API base for the Next.js BFF. Compose injects this into midtable-frontend.
# Use the Compose service DNS here; browser clients keep using NEXT_PUBLIC_API_URL above.
# On Cloud Run, the deploy workflow sets API_URL from the API_URL GitHub secret (public API origin).
API_URL=http://midtable-api:8000

