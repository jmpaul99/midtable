NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Project Settings → API → publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public origin (Cloud Run URL or custom domain); used for metadata / absolute URLs
# NEXT_PUBLIC_SITE_URL=https://your-frontend.example.com
# Cloudflare Turnstile sitekey (public). Local dummy: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
# Server-only — must match API INTERNAL_API_SECRET (never NEXT_PUBLIC_*)
INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Optional when running Next on the host (not Compose). Defaults to NEXT_PUBLIC_API_URL.
# Under Compose, set API_URL in the repo-root .env instead (injected into the container).
# API_URL=http://localhost:8000
